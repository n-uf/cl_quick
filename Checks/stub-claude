#!/bin/bash
# A stand-in for `claude` in print mode with stream-json in and out, for cl_quick's Checks. No account, no network.
# The quick chat passes `claude` only an allowlisted environment, so the stand-in reads its settings from stub.conf in
# the folder above the one it runs in (the work folder):
#   mode=ok (default)  each message gets "Answer N", streamed, then a result
#   mode=auth          "Not logged in", as Claude Code says it with no sign-in
#   mode=crash         half an answer, a line on stderr, then exit 3
#   mode=die           reads nothing: after 0.4 s a line on stderr, then exit 5 (a Claude Code that dies at startup while
#                      the chat is still writing its message to it)
#   mode=slow        half an answer, then it waits for 30 s and doesn't listen (a Claude Code that can't be interrupted)
#   mode=abort         half an answer, then it waits for an interrupt control request, ends that answer with an
#                      aborted result, and answers the next message normally (its count of messages goes on)
#   mode=limitword     an ordinary answer whose text talks about a rate limit ("…the rate limit reached its cap…")
#   mode=limit         Claude Code's refusal on a full limit (synthetic message with error rate_limit, an error result)
#   mode=web           a web answer shaped like Claude Code 2.1.318's (captured from a real one, sample text): text ("Let me
#                      open that page."), a WebFetch tool_use (stream events, then the assistant message), a rate_limit_event,
#                      the user message with the tool_result (a text that must never reach the screen), then more text
#                      ("It is a sample page.") and a result holding only that last text, as the real one does
#   mode=webhold       the first answer is mode=web's up to the tool call, then waits for an interrupt (the tool is still
#                      running), ends with the tool_result of an interrupted tool and an aborted result; later answers are
#                      mode=web's
#   tool=search        in mode=web / webhold the call is a WebSearch (query "swift concurrency actors")
#   tooldelay=SECONDS  mode=web waits that long between the tool call and its result (the tool is running)
#   control requests   each one is answered with a control_response and written to args.ctl (subtype and what it sets);
#                      `initialize` gets a list of models shaped like Claude Code 2.1.318's (sample names);
#                      `get_usage` gets limits shaped like 2.1.318's (sample numbers: 5 hours 44%, week 12%)
#   args=FILE          writes its arguments, a few environment values, its folder and its pid there; each user message
#                      line, as it came, goes to FILE.in
#   usage=none         `get_usage` gets no answer at all
#   usage=error        `get_usage` gets an error answer
#   usage=null         `get_usage` answers as 2.1.318 does when its usage endpoint gave nothing: rate_limits null
#   usagedelay=SECONDS `get_usage` is answered that long after it was asked (an answer still on its way)
#   account=EMAIL      who `initialize` says the process is (its `account`); `none` leaves it out (a key or a token).
#                      By default the address in $CLAUDE_CONFIG_DIR/.claude.json as the stand-in started, as Claude Code
#                      reads it (never the home folder's file: no CLAUDE_CONFIG_DIR, no account)
#   delay=SECONDS    waits that long, after its first line, before it reads any stdin (a slow or stalled reader)
conf="$(cd "$PWD/.." && pwd)/stub.conf"
mode="$(sed -n 's/^mode=//p' "$conf" 2>/dev/null)"; mode="${mode:-ok}"
QC_STUB_ARGS="$(sed -n 's/^args=//p' "$conf" 2>/dev/null)"
usage="$(sed -n 's/^usage=//p' "$conf" 2>/dev/null)"
usagedelay="$(sed -n 's/^usagedelay=//p' "$conf" 2>/dev/null)"
account="$(sed -n 's/^account=//p' "$conf" 2>/dev/null)"
tool="$(sed -n 's/^tool=//p' "$conf" 2>/dev/null)"
tooldelay="$(sed -n 's/^tooldelay=//p' "$conf" 2>/dev/null)"
org=""
if [ -z "$account" ] && [ -n "${CLAUDE_CONFIG_DIR:-}" ] && [ -f "$CLAUDE_CONFIG_DIR/.claude.json" ]; then
  account="$(sed -n 's/.*"emailAddress":"\([^"]*\)".*/\1/p' "$CLAUDE_CONFIG_DIR/.claude.json" | head -1)"
  org="$(sed -n 's/.*"organizationName":"\([^"]*\)".*/\1/p' "$CLAUDE_CONFIG_DIR/.claude.json" | head -1)"
fi
if [ -z "$account" ] || [ "$account" = none ]; then acct_json=''
else acct_json=',"account":{"email":"'"$account"'"'"${org:+,\"organization\":\"$org\"}"',"subscriptionType":"Claude Max","apiProvider":"firstParty"}'; fi
if [ -n "${QC_STUB_ARGS:-}" ]; then
  {
    for a in "$@"; do printf 'ARG [%s]\n' "$a"; done
    printf 'ENV CLAUDE_CONFIG_DIR=%s\n' "${CLAUDE_CONFIG_DIR-<unset>}"
    printf 'ENV TRAFFIC=%s\n' "${CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC-}"
    printf 'ENV KEY=%s\n' "${ANTHROPIC_API_KEY-<unset>}"
    printf 'ENV TOKEN=%s\n' "${CLAUDE_CODE_OAUTH_TOKEN-<unset>}"
    printf 'PWD %s\n' "$PWD"
    printf 'PID %s\n' "$$"
  } > "$QC_STUB_ARGS"
fi
sid="00000000-0000-4000-8000-000000000001"
delta() { printf '{"type":"stream_event","event":{"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"%s"}},"session_id":"%s"}\n' "$1" "$sid"; }
echo '{"type":"system","subtype":"init","session_id":"'$sid'","model":"claude-haiku-5-5","tools":[]}'
n=0
delay="$(sed -n 's/^delay=//p' "$conf" 2>/dev/null)"
[ -n "$delay" ] && sleep "$delay"
if [ "$mode" = die ]; then
  sleep 0.4
  echo "Error: sample startup failure for the checks" >&2
  exit 5
fi
ctl() { [ -n "${QC_STUB_ARGS:-}" ] && printf '%s\n' "$1" >> "$QC_STUB_ARGS.ctl"; return 0; }
while IFS= read -r line; do
  case "$line" in
    *'"type":"control_request"'*)
      rid="$(printf '%s' "$line" | sed -n 's/.*"request_id":"\([^"]*\)".*/\1/p')"
      sub="$(printf '%s' "$line" | sed -n 's/.*"subtype":"\([^"]*\)".*/\1/p')"
      mdl="$(printf '%s' "$line" | sed -n 's/.*"model":"\([^"]*\)".*/\1/p')"
      ctl "CTRL $sub ${mdl:+model=$mdl} $(printf '%s' "$line" | sed -n 's/.*"settings":\({[^}]*}\).*/settings=\1/p')"
      if [ "$mdl" = refuse ]; then
        echo '{"type":"control_response","response":{"subtype":"error","request_id":"'$rid'","error":"no such model"}}'
      elif [ "$sub" = get_usage ] && [ "$usage" = none ]; then
        :       # no answer at all
      elif [ "$sub" = get_usage ] && [ "$usage" = error ]; then
        echo '{"type":"control_response","response":{"subtype":"error","request_id":"'$rid'","error":"usage unavailable"}}'
      elif [ "$sub" = get_usage ] && [ "$usage" = null ]; then
        [ -n "$usagedelay" ] && sleep "$usagedelay"
        echo '{"type":"control_response","response":{"subtype":"success","request_id":"'$rid'","response":{"session":{"total_cost_usd":0},"subscription_type":"max","rate_limits_available":true,"rate_limits":null,"behaviors":null}}}'
      elif [ "$sub" = get_usage ]; then
        [ -n "$usagedelay" ] && sleep "$usagedelay"
        # the two windows (resets far ahead, so they're never past when a check reads them), plus keys cl_quick leaves
        # alone (spend, the per-model weeks, unknown ones)
        echo '{"type":"control_response","response":{"subtype":"success","request_id":"'$rid'","response":{"subscription_type":"max","rate_limits_available":true,"rate_limits":{"five_hour":{"utilization":44,"resets_at":"2036-11-10T18:00:00.123456+00:00","locked_reason":null,"used_dollars":1.5},"seven_day":{"utilization":12,"resets_at":"2036-11-14T09:00:00Z","locked_reason":null},"seven_day_opus":null,"spend":{"total":3},"cedar_ember":{"x":1}},"session":{"cost":0}}}}'
      elif [ "$sub" = initialize ]; then
        # "default", an alias that isn't the newest (fable is 5.1, 5.2 exists), an older version, a model with no efforts
        echo '{"type":"control_response","response":{"subtype":"success","request_id":"'$rid'","response":{"commands":[],"models":[{"value":"default","displayName":"Opus 5.5","description":"Default","supportedEffortLevels":["low","medium","high","xhigh","max"]},{"value":"opus","displayName":"Opus 5.5","description":"For the hardest work","supportedEffortLevels":["low","medium","high","xhigh","max"],"supportsEffort":true},{"value":"claude-fable-5-2","displayName":"Fable 5.2","description":"Newest Fable","supportedEffortLevels":["low","medium","high","xhigh","max"]},{"value":"sonnet","displayName":"Sonnet 5.5","description":"Everyday","supportedEffortLevels":["low","medium","high","xhigh"]},{"value":"haiku","displayName":"Haiku 5.5","description":"Fastest","supportsEffort":false},{"value":"fable","displayName":"Fable 5.1","supportedEffortLevels":["low","medium","high"]},{"value":"claude-opus-4-8","displayName":"Opus 4.8","supportedEffortLevels":["low","medium","high"]}]'"$acct_json"'}}}'
      elif [ "$sub" = set_model ]; then
        echo '{"type":"control_response","response":{"subtype":"success","request_id":"'$rid'","response":{"model":"claude-'${mdl:-opus}'-5-5"}}}'
      else
        echo '{"type":"control_response","response":{"subtype":"success","request_id":"'$rid'"}}'
      fi
      continue ;;
  esac
  n=$((n + 1))
  ctl "USER $n"
  [ -n "${QC_STUB_ARGS:-}" ] && printf '%s\n' "$line" >> "$QC_STUB_ARGS.in"     # the message as it came (images included)
  m="$mode"; [ "$mode" = abort ] && [ "$n" -gt 1 ] && m=ok      # abort mode aborts the first answer only
  [ "$mode" = webhold ] && [ "$n" -gt 1 ] && m=web              # so does webhold
  case "$m" in
    web|webhold)
      delta "Let me open that page."
      echo '{"type":"assistant","message":{"model":"claude-haiku-5-5","role":"assistant","content":[{"type":"text","text":"Let me open that page."}]},"session_id":"'$sid'"}'
      if [ "$tool" = search ]; then tname=WebSearch; tinput='{"query":"swift concurrency actors"}'
      else tname=WebFetch; tinput='{"url":"https://www.example.com/page","prompt":"Summarize this page."}'; fi
      echo '{"type":"stream_event","event":{"type":"content_block_start","index":1,"content_block":{"type":"tool_use","id":"toolu_stub1","name":"'$tname'","input":{},"caller":{"type":"direct"}}},"session_id":"'$sid'"}'
      echo '{"type":"stream_event","event":{"type":"content_block_delta","index":1,"delta":{"type":"input_json_delta","partial_json":""}},"session_id":"'$sid'"}'
      echo '{"type":"assistant","message":{"model":"claude-haiku-5-5","role":"assistant","content":[{"type":"tool_use","id":"toolu_stub1","name":"'$tname'","input":'"$tinput"',"caller":{"type":"direct"}}]},"session_id":"'$sid'"}'
      echo '{"type":"rate_limit_event","rate_limit_info":{"status":"allowed","resetsAt":1794776400,"rateLimitType":"seven_day","unifiedWindows":{"seven_day":{"utilization":0.62,"resetsAt":1794776400,"status":"allowed"}}},"session_id":"'$sid'"}'
      if [ "$m" = webhold ]; then
        # the tool is running: the next line is the interrupt; the tool ends with an error result, then the answer is aborted
        while IFS= read -r line2; do
          case "$line2" in *'"subtype":"interrupt"'*) break ;; esac
        done
        ctl "CTRL interrupt"
        rid="$(printf '%s' "$line2" | sed -n 's/.*"request_id":"\([^"]*\)".*/\1/p')"
        echo '{"type":"control_response","response":{"subtype":"success","request_id":"'$rid'","response":{"still_queued":[]}}}'
        echo '{"type":"user","message":{"role":"user","content":[{"type":"tool_result","content":"SECRET-TOOL-RESULT-TEXT interrupted","is_error":true,"tool_use_id":"toolu_stub1"}]},"session_id":"'$sid'"}'
        echo '{"type":"result","subtype":"error_during_execution","is_error":true,"duration_ms":30,"terminal_reason":"aborted_tools","session_id":"'$sid'"}'
      else
        [ -n "$tooldelay" ] && sleep "$tooldelay"
        echo '{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_stub1","type":"tool_result","content":"SECRET-TOOL-RESULT-TEXT the page says things"}]},"parent_tool_use_id":null,"session_id":"'$sid'","tool_use_result":{"bytes":577,"code":200,"codeText":"OK","result":"SECRET-TOOL-RESULT-TEXT the page says things","durationMs":1256,"url":"https://www.example.com/page"}}'
        delta "It is a "
        delta "sample page."
        echo '{"type":"assistant","message":{"model":"claude-haiku-5-5","role":"assistant","content":[{"type":"text","text":"It is a sample page."}]},"session_id":"'$sid'"}'
        echo '{"type":"result","subtype":"success","is_error":false,"result":"It is a sample page.","duration_ms":1200,"session_id":"'$sid'"}'
      fi
      ;;
    abort)
      delta "Half an ans"
      # the next line is the interrupt; the answer ends with an aborted result, as Claude Code's does
      while IFS= read -r line2; do
        case "$line2" in *'"subtype":"interrupt"'*) break ;; esac
      done
      ctl "CTRL interrupt"
      rid="$(printf '%s' "$line2" | sed -n 's/.*"request_id":"\([^"]*\)".*/\1/p')"
      echo '{"type":"control_response","response":{"subtype":"success","request_id":"'$rid'","response":{"still_queued":[]}}}'
      echo '{"type":"result","subtype":"error_during_execution","is_error":true,"duration_ms":30,"terminal_reason":"aborted_streaming","session_id":"'$sid'"}'
      ;;
    limitword)
      # an ordinary answer (a page's summary, say) that talks about rate limits: not a limit
      delta "A 429 means the rate limit reached its cap, so retry later."
      echo '{"type":"assistant","message":{"model":"claude-haiku-5-5","role":"assistant","content":[{"type":"text","text":"A 429 means the rate limit reached its cap, so retry later."}]},"session_id":"'$sid'"}'
      echo '{"type":"result","subtype":"success","is_error":false,"result":"A 429 means the rate limit reached its cap, so retry later.","duration_ms":1200,"session_id":"'$sid'"}'
      ;;
    limit)
      # a real refusal: Claude Code's own message (synthetic model, error rate_limit), then an error result
      echo '{"type":"assistant","message":{"model":"<synthetic>","role":"assistant","content":[{"type":"text","text":"You'"'"'ve hit your limit · resets 5pm"}]},"error":"rate_limit","session_id":"'$sid'"}'
      echo '{"type":"result","subtype":"success","is_error":true,"result":"You'"'"'ve hit your limit · resets 5pm","duration_ms":5,"session_id":"'$sid'"}'
      ;;
    auth)
      echo '{"type":"assistant","message":{"model":"<synthetic>","role":"assistant","content":[{"type":"text","text":"Not logged in · Please run /login"}]},"error":"authentication_failed","session_id":"'$sid'"}'
      echo '{"type":"result","subtype":"success","is_error":true,"result":"Not logged in · Please run /login","duration_ms":5,"session_id":"'$sid'"}'
      ;;
    crash)
      delta "Half an ans"
      echo "Error: sample failure for the checks" >&2
      exit 3
      ;;
    slow)
      delta "Half an ans"
      # a child in a group of its own, as a tool Claude Code runs would be: when this script is stopped the child lives
      # on holding the output pipe open (macOS 26's Process.terminate ends only the process, not its group)
      set -m
      sleep 30 &
      wait $!
      ;;
    *)
      delta "Answer "
      delta "$n"
      echo '{"type":"assistant","message":{"model":"claude-haiku-5-5","role":"assistant","content":[{"type":"text","text":"Answer '$n'"}]},"session_id":"'$sid'"}'
      echo '{"type":"rate_limit_event","rate_limit_info":{"status":"allowed","resetsAt":1794776400,"rateLimitType":"seven_day","unifiedWindows":{"seven_day":{"utilization":0.62,"resetsAt":1794776400,"status":"allowed"}}},"session_id":"'$sid'"}'
      echo '{"type":"result","subtype":"success","is_error":false,"result":"Answer '$n'","duration_ms":1200,"session_id":"'$sid'"}'
      ;;
  esac
done
