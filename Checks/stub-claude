#!/bin/bash
# A stand-in for `claude` in print mode with stream-json in and out, for cl_quick's Checks. No account, no network.
# The quick chat passes `claude` only an allowlisted environment, so the stand-in reads its settings from stub.conf in
# the folder above the one it runs in (the work folder):
#   mode=ok (default)  each message gets "Answer N", streamed, then a result
#   mode=auth          "Not logged in", as Claude Code says it with no sign-in
#   mode=crash         half an answer, a line on stderr, then exit 3
#   mode=slow          half an answer, then it waits for 30 s and doesn't listen (a Claude Code that can't be interrupted)
#   mode=abort         half an answer, then it waits for an interrupt control request, ends that answer with an
#                      aborted result, and answers the next message normally (its count of messages goes on)
#   control requests   each one is answered with a control_response and written to args.ctl (subtype and what it sets);
#                      `initialize` gets a list of models shaped like Claude Code 2.1.318's (sample names);
#                      `get_usage` gets limits shaped like 2.1.318's (sample numbers: 5 hours 44%, week 12%)
#   args=FILE          writes its arguments, a few environment values, its folder and its pid there; each user message
#                      line, as it came, goes to FILE.in
conf="$(cd "$PWD/.." && pwd)/stub.conf"
mode="$(sed -n 's/^mode=//p' "$conf" 2>/dev/null)"; mode="${mode:-ok}"
QC_STUB_ARGS="$(sed -n 's/^args=//p' "$conf" 2>/dev/null)"
if [ -n "${QC_STUB_ARGS:-}" ]; then
  {
    for a in "$@"; do printf 'ARG [%s]\n' "$a"; done
    printf 'ENV CLAUDE_CONFIG_DIR=%s\n' "${CLAUDE_CONFIG_DIR-<unset>}"
    printf 'ENV TRAFFIC=%s\n' "${CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC-}"
    printf 'ENV KEY=%s\n' "${ANTHROPIC_API_KEY-<unset>}"
    printf 'ENV TOKEN=%s\n' "${CLAUDE_CODE_OAUTH_TOKEN-<unset>}"
    printf 'PWD %s\n' "$PWD"
    printf 'PID %s\n' "$$"
  } > "$QC_STUB_ARGS"
fi
sid="00000000-0000-4000-8000-000000000001"
delta() { printf '{"type":"stream_event","event":{"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"%s"}},"session_id":"%s"}\n' "$1" "$sid"; }
echo '{"type":"system","subtype":"init","session_id":"'$sid'","model":"claude-haiku-5-5","tools":[]}'
n=0
ctl() { [ -n "${QC_STUB_ARGS:-}" ] && printf '%s\n' "$1" >> "$QC_STUB_ARGS.ctl"; return 0; }
while IFS= read -r line; do
  case "$line" in
    *'"type":"control_request"'*)
      rid="$(printf '%s' "$line" | sed -n 's/.*"request_id":"\([^"]*\)".*/\1/p')"
      sub="$(printf '%s' "$line" | sed -n 's/.*"subtype":"\([^"]*\)".*/\1/p')"
      mdl="$(printf '%s' "$line" | sed -n 's/.*"model":"\([^"]*\)".*/\1/p')"
      ctl "CTRL $sub ${mdl:+model=$mdl} $(printf '%s' "$line" | sed -n 's/.*"settings":\({[^}]*}\).*/settings=\1/p')"
      if [ "$mdl" = refuse ]; then
        echo '{"type":"control_response","response":{"subtype":"error","request_id":"'$rid'","error":"no such model"}}'
      elif [ "$sub" = get_usage ]; then
        # the two windows (resets far ahead, so they're never past when a check reads them), plus keys cl_quick leaves
        # alone (spend, the per-model weeks, unknown ones)
        echo '{"type":"control_response","response":{"subtype":"success","request_id":"'$rid'","response":{"subscription_type":"max","rate_limits_available":true,"rate_limits":{"five_hour":{"utilization":44,"resets_at":"2036-11-10T18:00:00.123456+00:00","locked_reason":null,"used_dollars":1.5},"seven_day":{"utilization":12,"resets_at":"2036-11-14T09:00:00Z","locked_reason":null},"seven_day_opus":null,"spend":{"total":3},"cedar_ember":{"x":1}},"session":{"cost":0}}}}'
      elif [ "$sub" = initialize ]; then
        # "default", an alias that isn't the newest (fable is 5.1, 5.2 exists), an older version, a model with no efforts
        echo '{"type":"control_response","response":{"subtype":"success","request_id":"'$rid'","response":{"commands":[],"models":[{"value":"default","displayName":"Opus 5.5","description":"Default","supportedEffortLevels":["low","medium","high","xhigh","max"]},{"value":"opus","displayName":"Opus 5.5","description":"For the hardest work","supportedEffortLevels":["low","medium","high","xhigh","max"],"supportsEffort":true},{"value":"claude-fable-5-2","displayName":"Fable 5.2","description":"Newest Fable","supportedEffortLevels":["low","medium","high","xhigh","max"]},{"value":"sonnet","displayName":"Sonnet 5.5","description":"Everyday","supportedEffortLevels":["low","medium","high","xhigh"]},{"value":"haiku","displayName":"Haiku 5.5","description":"Fastest","supportsEffort":false},{"value":"fable","displayName":"Fable 5.1","supportedEffortLevels":["low","medium","high"]},{"value":"claude-opus-4-8","displayName":"Opus 4.8","supportedEffortLevels":["low","medium","high"]}]}}}'
      elif [ "$sub" = set_model ]; then
        echo '{"type":"control_response","response":{"subtype":"success","request_id":"'$rid'","response":{"model":"claude-'${mdl:-opus}'-5-5"}}}'
      else
        echo '{"type":"control_response","response":{"subtype":"success","request_id":"'$rid'"}}'
      fi
      continue ;;
  esac
  n=$((n + 1))
  ctl "USER $n"
  [ -n "${QC_STUB_ARGS:-}" ] && printf '%s\n' "$line" >> "$QC_STUB_ARGS.in"     # the message as it came (images included)
  m="$mode"; [ "$mode" = abort ] && [ "$n" -gt 1 ] && m=ok      # abort mode aborts the first answer only
  case "$m" in
    abort)
      delta "Half an ans"
      # the next line is the interrupt; the answer ends with an aborted result, as Claude Code's does
      while IFS= read -r line2; do
        case "$line2" in *'"subtype":"interrupt"'*) break ;; esac
      done
      ctl "CTRL interrupt"
      rid="$(printf '%s' "$line2" | sed -n 's/.*"request_id":"\([^"]*\)".*/\1/p')"
      echo '{"type":"control_response","response":{"subtype":"success","request_id":"'$rid'","response":{"still_queued":[]}}}'
      echo '{"type":"result","subtype":"error_during_execution","is_error":true,"duration_ms":30,"terminal_reason":"aborted_streaming","session_id":"'$sid'"}'
      ;;
    auth)
      echo '{"type":"assistant","message":{"model":"<synthetic>","role":"assistant","content":[{"type":"text","text":"Not logged in · Please run /login"}]},"error":"authentication_failed","session_id":"'$sid'"}'
      echo '{"type":"result","subtype":"success","is_error":true,"result":"Not logged in · Please run /login","duration_ms":5,"session_id":"'$sid'"}'
      ;;
    crash)
      delta "Half an ans"
      echo "Error: sample failure for the checks" >&2
      exit 3
      ;;
    slow)
      delta "Half an ans"
      sleep 30
      ;;
    *)
      delta "Answer "
      delta "$n"
      echo '{"type":"assistant","message":{"model":"claude-haiku-5-5","role":"assistant","content":[{"type":"text","text":"Answer '$n'"}]},"session_id":"'$sid'"}'
      echo '{"type":"rate_limit_event","rate_limit_info":{"status":"allowed","resetsAt":1794776400,"rateLimitType":"seven_day","unifiedWindows":{"seven_day":{"utilization":0.62,"resetsAt":1794776400,"status":"allowed"}}},"session_id":"'$sid'"}'
      echo '{"type":"result","subtype":"success","is_error":false,"result":"Answer '$n'","duration_ms":1200,"session_id":"'$sid'"}'
      ;;
  esac
done
